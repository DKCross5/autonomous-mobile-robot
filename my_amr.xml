<mujoco model="my_amr">
  <option gravity="0 0 -9.81"/>
  
  <worldbody>
    <!-- Floor and Lighting -->
    <light pos="0 0 3"/>
    <geom name="floor" type="plane" size="5 5 0.1" rgba=".9 .9 .9 1"/>

    <!-- Obstacle (Red wall for the LiDAR to detect, placed 2.5m ahead for driving room) -->
    <body name="obstacle_wall" pos="2.5 0 0.5">
      <geom name="wall_geom" type="box" size="0.1 1 0.5" rgba="1 0 0 1"/>
    </body>

    <!-- Robot Chassis (Trapezoidal / Triangular 3-wheel base) -->
    <!-- Axle center is at z = 0.0762m (6" wheel radius) so wheels rest directly on the floor (z=0) -->
    <body name="chassis" pos="0 0 0.0762">
      <joint type="free"/> <!-- 6-DOF joint allowing robot to drive around the world -->
      
      <!-- Main Chassis Body (Tapered trapezoidal deck) -->
      <geom name="chassis_geom" type="box" size="0.20 0.14 0.04" pos="-0.04 0 0.02" rgba="0 0.4 0.8 1"/>
      
      <!-- Rear Caster Mount and Caster Ball (Swivel caster on the back) -->
      <geom name="caster_mount" type="cylinder" size="0.035 0.02" pos="-0.22 0 -0.01" rgba="0.2 0.2 0.2 1"/>
      <!-- Sphere radius 0.035m, positioned at z = -0.0412 so bottom touches ground (0.0762 - 0.0412 - 0.035 = 0.0) -->
      <geom name="caster_ball" type="sphere" size="0.035" pos="-0.22 0 -0.0412" rgba="0.6 0.6 0.6 1"/>

      <!-- Left Drive Wheel (~6 inch diameter -> radius 0.0762m, width 0.04m) -->
      <body name="left_wheel" pos="0 0.18 0">
        <!-- Armature reflects electric motor rotor inertia; prevents numerical explosions in velocity control -->
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0" damping="0.1" armature="0.01"/>
        <geom name="left_wheel_geom" type="cylinder" size="0.0762 0.02" zaxis="0 1 0" rgba="0.15 0.15 0.15 1" friction="1.5 0.005 0.0001"/>
      </body>

      <!-- Right Drive Wheel (~6 inch diameter -> radius 0.0762m, width 0.04m) -->
      <body name="right_wheel" pos="0 -0.18 0">
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0" damping="0.1" armature="0.01"/>
        <geom name="right_wheel_geom" type="cylinder" size="0.0762 0.02" zaxis="0 1 0" rgba="0.15 0.15 0.15 1" friction="1.5 0.005 0.0001"/>
      </body>
      
      <!-- Spinning LiDAR Head (Green Cylinder) mounted on top deck -->
      <body name="lidar" pos="0.05 0 0.09">
        <joint name="lidar_spin" type="hinge" axis="0 0 1" damping="0.01"/>
        <geom name="lidar_geom" type="cylinder" size="0.05 0.02" rgba="0 1 0 1"/>
        
        <!-- Rangefinder site shooting horizontal laser beam forward (+X) -->
        <site name="lidar_beam" pos="0.05 0 0" type="cylinder" size="0.01 0.01" rgba="1 1 0 1" zaxis="1 0 0"/>
      </body>
    </body>
  </worldbody>

  <!-- Contacts: explicitly specify frictionless pair between caster and floor to avoid inheriting floor default friction -->
  <contact>
    <pair geom1="floor" geom2="caster_ball" friction="0.001 0.001 0.001 0.001 0.001"/>
  </contact>

  <!-- Sensors -->
  <sensor>
    <rangefinder name="lidar_dist" site="lidar_beam"/>
  </sensor>

  <!-- Actuators -->
  <actuator>
    <!-- LiDAR motor -->
    <velocity name="lidar_motor" joint="lidar_spin" kv="0.1"/>
    <!-- Drive motors for differential drive (kv=3.0 for responsive velocity tracking without droop) -->
    <velocity name="left_motor" joint="left_wheel_joint" kv="3.0"/>
    <velocity name="right_motor" joint="right_wheel_joint" kv="3.0"/>
  </actuator>
</mujoco>
